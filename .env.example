# Copy to .env and fill in. Every key here is validated at boot by
# src/config/env.validation.ts — a missing or malformed value fails startup.

# --- Application ---
NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=1
CORS_ORIGIN=*
SWAGGER_ENABLED=true

# --- Database (matches docker-compose.yml) ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=ticket_reservation
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_SSL=false

# --- Auth (generated key pair, base64-encoded PEM) ---
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=
