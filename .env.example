ORDER_SERVICE_BASE_URL = http://localhost:3001
USER_SERVICE_BASE_URL = http://localhost:3003
PRODUCT_SERVICE_BASE_URL = http://localhost:3004

# TCP client target hosts (default to localhost for local multi-process dev,
# where every app runs on the same machine). Docker Compose/Kubernetes override
# these to the other service's container/Service DNS name — see docker-compose.yml.
INVENTORY_SERVICE_HOST = localhost
ORDER_SERVICE_HOST = localhost
AUTH_SERVICE_HOST = localhost
USER_SERVICE_HOST = localhost

# RS256 keypair for JWT auth. auth app signs with the private key;
# user/product/api-gateway verify with the public key only. Base64-encoded PEM.
# Generate locally with:
#   node -e "const c=require('crypto');const{publicKey,privateKey}=c.generateKeyPairSync('rsa',{modulusLength:2048,publicKeyEncoding:{type:'spki',format:'pem'},privateKeyEncoding:{type:'pkcs8',format:'pem'}});console.log('JWT_PRIVATE_KEY_BASE64='+Buffer.from(privateKey).toString('base64'));console.log('JWT_PUBLIC_KEY_BASE64='+Buffer.from(publicKey).toString('base64'));"
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=
