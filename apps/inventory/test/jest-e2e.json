{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "setupFiles": ["dotenv/config"],
  "moduleNameMapper": {
    "^@app/constants(|/.*)$": "<rootDir>/../../../libs/constants/src/$1",
    "^@app/common(|/.*)$": "<rootDir>/../../../libs/common/src/$1"
  }
}
