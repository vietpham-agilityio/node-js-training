{
  "name": "@movea/api-contract",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "description": "TypeScript contract generated from the @movea/api OpenAPI document",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "openapi.json"
  ],
  "scripts": {
    "generate": "openapi-typescript openapi.json -o src/generated/schema.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint:check": "echo \"no lint config yet — generated sources only\""
  },
  "devDependencies": {
    "openapi-typescript": "^7.9.1",
    "typescript": "^5.7.3"
  }
}
